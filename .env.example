# =========================================================================
# PrevioPLS Security API — variaveis de ambiente
# =========================================================================
# NUNCA commitar o .env. Os campos vazios abaixo sao preenchidos com valores
# aleatorios por:  python scripts/bootstrap_env.py
# Em producao os segredos vem do secret manager (Azure Key Vault / AWS Secrets
# Manager / Vault) e o APP_ENV=production faz o boot recusar valor fraco.
# =========================================================================

APP_ENV=development
APP_NAME=previo-pls-security
APP_VERSION=3.0.0

# ---- Postgres (a URL e montada no compose) ----
POSTGRES_USER=previopls
POSTGRES_DB=previopls
POSTGRES_PASSWORD=

# ---- JWT RS256 ----
# em dev o par e gerado no primeiro boot (volume jwt_keys); em prod vem do KMS
JWT_PRIVATE_KEY_PATH=/app/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/jwt_public.pem
JWT_ISSUER=previo-pls
JWT_AUDIENCE=previo-pls-clients
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ---- Criptografia de PII (Fernet) ----
# "nova,antiga" durante rotacao; depois de python -m app.cli.rotate_keys tira a antiga
FERNET_KEYS=
# HMAC deterministico do CPF (lookup sem decifrar)
CPF_HASH_PEPPER=
# assinatura dos webhooks de faturamento (POST /v1/clientes)
HMAC_PAYLOAD_SECRET=

# ---- CORS (whitelist explicita) ----
CORS_ORIGINS=https://localhost:8443

# ---- Rate limit ----
RATE_LIMIT_GLOBAL=100/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_LLM=10/minute
RATE_LIMIT_STORAGE_URI=memory://

# ---- Lockout ----
LOCKOUT_MAX_FAILURES=5
LOCKOUT_WINDOW_SECONDS=60
LOCKOUT_DURATION_SECONDS=900

# ---- LGPD ----
RETENTION_YEARS=5
TELEMETRIA_RETENTION_DAYS=90

# ---- Observabilidade ----
# prometheus manda este token no scrape do /metrics
METRICS_TOKEN=
GRAFANA_ADMIN_PASSWORD=
# alertas de seguranca da propria api (brute force, reuso de refresh) vao pro alert-sink
SECURITY_ALERT_WEBHOOK_URL=http://alert-sink:9095/api/alerta

# ---- Usuarios de demo (so fora de producao) ----
SEED_DEFAULT_USERS=true
SEED_ADMIN_PASSWORD=
SEED_CONSULTOR_PASSWORD=
SEED_ANALISTA_PASSWORD=

# ---- Primeiro admin de producao (opcional) ----
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
